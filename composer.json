{
    "name": "webwizo/laravel-shortcodes-filament",
    "description": "Filament 3 plugin for managing Laravel Shortcodes via admin panel",
    "keywords": ["laravel", "filament", "shortcodes", "plugin", "cms"],
    "license": "MIT",
    "authors": [
        {
            "name": "Asif Iqbal",
            "email": "webwizo@gmail.com",
            "homepage": "https://github.com/webwizo",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "webwizo/laravel-shortcodes": "^1.0",
        "filament/filament": "^3.0 || ^4.0 || ^5.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Webwizo\\ShortcodesFilament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webwizo\\ShortcodesFilament\\ShortcodesFilamentServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}